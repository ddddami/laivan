{
  "name": "laivan",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "contract:generate": "pnpm --package=openapi-typescript@7.13.0 dlx openapi-typescript openapi/openapi.yaml -o web/src/api/schema.gen.ts --immutable",
    "contract:check": "pnpm --package=openapi-typescript@7.13.0 dlx openapi-typescript openapi/openapi.yaml -o web/src/api/schema.gen.ts --immutable --check",
    "web:build": "pnpm --filter web build",
    "web:check": "pnpm --filter web check",
    "web:dev": "pnpm --filter web dev",
    "web:fmt": "pnpm --filter web fmt",
    "web:lint": "pnpm --filter web lint",
    "web:test": "pnpm --filter web test",
    "web:typecheck": "pnpm --filter web typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@parcel/watcher", "esbuild", "lightningcss", "workerd"]
  }
}
